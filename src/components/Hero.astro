---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import { allNodes, byRole, nodeUrl } from '../lib/method';
import { SITE, href } from '../lib/site';
interface Props { widgets: number }
const { widgets } = Astro.props;
const STAGE_ICON: Record<number, IconName> = { 1: 'inbox', 2: 'decision', 3: 'promise', 4: 'delivery', 5: 'effect' };
const stages = byRole(await allNodes(), 'stage');
---
<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <span class="orb orb--a"></span>
    <span class="orb orb--b"></span>
    <span class="orb orb--c"></span>
    <span class="dot dot--1"></span>
    <span class="dot dot--2"></span>
    <span class="dot dot--3"></span>
  </div>
  <div class="wrap hero__inner">
    <p class="pill" data-reveal><span class="pill__dot" aria-hidden="true"></span>{SITE.tagline}</p>
    <h1 id="hero-title" data-reveal>
      <span class="grad">po-helper-org</span>
      <span class="hero__sub">для вашего IT-департамента</span>
    </h1>
    <p class="lead hero__lead" data-reveal>
      {SITE.subtitle} <strong>{SITE.problem}</strong> Методология из пяти стадий и {widgets} виджетов автоматизации.
    </p>
    <p class="hero__tools-title" data-reveal>Пять стадий процесса Product Owner:</p>
    <ul class="hero__tools" data-reveal>
      {stages.map((s) => (
        <li>
          <a class="tool glass" href={nodeUrl(s)}>
            <span class="tool__icon"><Icon name={STAGE_ICON[s.data.stage ?? 1]} size={26} /></span>
            <span class="tool__name">{s.data.short}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="hero__actions" data-reveal>
      <a class="btn btn--lg" href={SITE.contact.href} target="_blank" rel="noopener">{SITE.contact.label}</a>
      <a class="btn btn--white btn--lg" href={href('/widgets/')}>Смотреть виджеты</a>
    </p>
  </div>
</section>
