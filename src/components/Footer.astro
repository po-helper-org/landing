---
import { SITE, PROFILES, href } from '../lib/site';
---
<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div>
      <p class="site-footer__brand">{SITE.name}</p>
      <p class="site-footer__text">{SITE.tagline}. {SITE.subtitle}</p>
      <a class="btn btn--light" href={SITE.contact.href} target="_blank" rel="noopener">{SITE.contact.label}</a>
    </div>
    <nav aria-label="Разделы">
      <p class="site-footer__title">Подсайт</p>
      <ul>
        <li><a href={href('/method/')}>Методология</a></li>
        <li><a href={href('/widgets/')}>Виджеты</a></li>
        <li><a href={SITE.origin + '/'}>aleksishmanov.ru</a></li>
      </ul>
    </nav>
    <nav aria-label="Профили">
      <p class="site-footer__title">Профили</p>
      <ul>
        {PROFILES.map((p) => <li><a href={p.href} target="_blank" rel="noopener">{p.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <p class="wrap site-footer__note">Автор: <a href={SITE.owner.href}>{SITE.owner.name}</a></p>
</footer>
