---
import Icon from './Icon.astro';
import { SITE, href } from '../lib/site';
interface Props { current?: 'home' | 'method' | 'widgets' }
const { current } = Astro.props;
---
<header class="site-header">
  <div class="site-header__bar">
    <a class="brand" href={href('/')}><span class="brand__mark" aria-hidden="true"></span>{SITE.name}</a>
    <nav class="site-nav" aria-label="Разделы подсайта">
      <a href={href('/method/')} aria-current={current === 'method' ? 'page' : undefined}>Методология</a>
      <a href={href('/widgets/')} aria-current={current === 'widgets' ? 'page' : undefined}>Виджеты</a>
      <a href={href('/#closed')}>Закрытый контур</a>
      <a href={href('/#connect')}>Как подключить</a>
      <a class="site-nav__back" href={SITE.mainOrigin + '/'}>← aleksishmanov.ru</a>
    </nav>
    <a class="icon-btn" href={SITE.contact.href} target="_blank" rel="noopener" aria-label="Написать в Telegram"><Icon name="telegram" size={20} /></a>
    <a class="btn btn--small" href={SITE.contact.href} target="_blank" rel="noopener">{SITE.contact.label}</a>
  </div>
</header>
